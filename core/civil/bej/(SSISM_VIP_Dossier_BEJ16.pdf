import os
from reportlab.lib.pagesizes import letter
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, HRFlowable
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle

def create_vip_dossier():
    pdf_filename = "SSISM_VIP_Dossier_BEJ16.pdf"
    doc = SimpleDocTemplate(
        pdf_filename,
        pagesize=letter,
        rightMargin=40,
        leftMargin=40,
        topMargin=40,
        bottomMargin=40
    )
    
    styles = getSampleStyleSheet()
    
    # Custom Palette for High-Level Security Intel
    PRIMARY_COLOR = colors.HexColor("#1A252C") # Dark Slate
    SECONDARY_COLOR = colors.HexColor("#7F1D1D") # Deep Burgundy Alert
    TEXT_COLOR = colors.HexColor("#27272A") # Charcoal text
    
    # Custom Typography Styles
    title_style = ParagraphStyle(
        'DocTitle',
        parent=styles['Normal'],
        fontName='Helvetica-Bold',
        fontSize=22,
        leading=26,
        textColor=PRIMARY_COLOR,
        spaceAfter=6
    )
    
    subtitle_style = ParagraphStyle(
        'DocSubtitle',
        parent=styles['Normal'],
        fontName='Helvetica-Bold',
        fontSize=11,
        leading=14,
        textColor=SECONDARY_COLOR,
        spaceAfter=15
    )
    
    h1_style = ParagraphStyle(
        'Heading1_Custom',
        parent=styles['Normal'],
        fontName='Helvetica-Bold',
        fontSize=14,
        leading=18,
        textColor=PRIMARY_COLOR,
        spaceBefore=12,
        spaceAfter=8,
        keepWithNext=True
    )

    body_style = ParagraphStyle(
        'Body_Custom',
        parent=styles['Normal'],
        fontName='Helvetica',
        fontSize=10,
        leading=14,
        textColor=TEXT_COLOR,
        spaceAfter=8
    )

    bullet_style = ParagraphStyle(
        'Bullet_Custom',
        parent=body_style,
        leftIndent=15,
        firstLineIndent=-10,
        spaceAfter=4
    )
    
    story = []
    
    # ----------------------------------------------------
    # HEADER SECTION
    # ----------------------------------------------------
    story.append(Paragraph("SSISM EXECUTIVE INTEL DOSSIER", title_style))
    story.append(Paragraph("CLASSIFICATION: TOP SECRET // SSISM VIP INTERNAL ONLY // NOT FOR PUBLIC DISTRIBUTION", subtitle_style))
    story.append(HRFlowable(width="100%", thickness=1.5, color=SECONDARY_COLOR, spaceAfter=15))
    
    # Metadata Table
    meta_data = [
        [Paragraph("<b>OPERATIONAL HUB:</b> Chiang Mai / Mae Sot Sector", body_style), 
         Paragraph("<b>SYSTEM DATE:</b> June 18, 2026", body_style)],
        [Paragraph("<b>INTEGRITY PROTOCOL:</b> SSISM-L6-SECURE", body_style), 
         Paragraph("<b>TARGET VECTOR:</b> Cross-Border State Apparatus Tracking", body_style)]
    ]
    meta_table = Table(meta_data, colWidths=[260, 260])
    meta_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,-1), colors.HexColor("#F4F4F5")),
        ('PADDING', (0,0), (-1,-1), 8),
        ('BOX', (0,0), (-1,-1), 0.5, colors.HexColor("#E4E4E7")),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
    ]))
    story.append(meta_table)
    story.append(Spacer(1, 15))
    
    # ----------------------------------------------------
    # EXECUTIVE SUMMARY
    # ----------------------------------------------------
    story.append(Paragraph("EXECUTIVE SUMMARY", h1_style))
    exec_summary_text = (
        "Advanced open-source intelligence (OSINT), field tracking, and linguistic pattern auditing "
        "have mapped a critical cross-border alignment matrix. This pipeline links high-level Thai academic-bureaucratic "
        "state machinery with local Burmese operational nodes inside the strategic Mae Sot corridor. The rapid flight deployment "
        "of a senior official from the sensitive Southern border zones (Hat Yai/Songkhla hub) directly to the Western frontier "
        "proves this is a highly formalized, state-sanctioned human terrain assessment mechanism operating under scholastic camouflage."
    )
    story.append(Paragraph(exec_summary_text, body_style))
    story.append(Spacer(1, 10))
    
    # ----------------------------------------------------
    # TARGET PROFILES
    # ----------------------------------------------------
    story.append(Paragraph("CORE TARGET INDIVIDUAL IDENTIFICATION", h1_style))
    
    # Target 1
    story.append(Paragraph("<b>Target 1: Primary State Bureaucrat — Somkiat Saithanoo</b>", body_style))
    story.append(Paragraph("&bull; <b>Official Profile:</b> High-ranking academic bureaucrat integrated with the Royal Thai Government administrative infrastructure. Historically positioned inside critical frontier nodes including Thaksin University, Prince of Songkla University (PSU) in the structurally sensitive Southern region, and Lampang Rajabhat University in the North.", bullet_style))
    story.append(Paragraph("&bull; <b>Linguistic Identity Anomaly:</b> Orthographic conversion of the Thai surname <i>Saithanoo</i> (สายธนู) unmasks a flawless structural match with the Shan/Burmese identity <b>'Sai Than Oo' (စိုင်းသန်းဦး)</b>. This denotes an <i>Identity Assimilation Pattern</i>, ensuring deep native cultural and linguistic penetration vectors into border corridors.", bullet_style))
    story.append(Paragraph("&bull; <b>Strategic Operations:</b> Mandated under the <b>National Research Council of Thailand (NRCT)</b> via the <b>Thai-Chinese Strategic Research Center</b>, managing field assessment deployments on the border.", bullet_style))
    
    story.append(Spacer(1, 5))
    
    # Target 2
    story.append(Paragraph("<b>Target 2: Border Facilitation Vector — Dr. Alex Win (DrAlex Win)</b>", body_style))
    story.append(Paragraph("&bull; <b>Institutional Anchor:</b> Deeply embedded coordinator within the <b>B.M.W.E.C. (Burmese Migrant Workers' Education Committee)</b> platform during its 25th Anniversary cycle (2000–2025).", bullet_style))
    story.append(Paragraph("&bull; <b>Operational Utility:</b> Serves as the localized host and physical proxy inside Mae Sot, facilitating structural verification access, local scheduling, and logistics for incoming state research entities.", bullet_style))
    
    story.append(Spacer(1, 10))
    
    # ----------------------------------------------------
    # GEOPOLITICAL IMPLICATIONS
    # ----------------------------------------------------
    story.append(Paragraph("STRATEGIC ANOMALIES & SYSTEMIC RISK", h1_style))
    intel_text = (
        "<b>Institutionalized Information Laundering:</b> The placement of the Mae Sot Field Research Unit under the "
        "Thai-Chinese Strategic Research Center banner provides an effective academic cover. This allows state networks to "
        "conduct deep demographic tracking and security tracking along the border corridor without provoking standard diplomatic "
        "friction protocols.<br/><br/>"
        "<b>Human Terrain Mapping:</b> By exploiting cross-border cultural affinity assets—including targeted visits to "
        "symbolic border spaces like Wat Thai Watthanaram (Wat Thai Yai)—the network effectively maps shifting migrant dynamics, "
        "refugee density clusters, and leadership alignments. This provides highly reliable baseline metrics to external state elements."
    )
    story.append(Paragraph(intel_text, body_style))
    story.append(Spacer(1, 10))
    
    # ----------------------------------------------------
    # V-ENGINE DEFENSE PROTOCOLS
    # ----------------------------------------------------
    story.append(Paragraph("SSISM V-ENGINE AUTOMATED SYSTEM COUNTERMEASURES", h1_style))
    
    proto_data = [
        [Paragraph("<b>PROTOCOL CODE</b>", body_style), Paragraph("<b>TRIGGER CONDITIONS & SYSTEM ACTIONS</b>", body_style)],
        [Paragraph("<b>LIA-01 (Linguistic Alert)</b>", body_style), Paragraph("Flags and screens any state-sponsored research initiatives managed by officials with dual-phonetic profiles operating in ethnic corridors.", body_style)],
        [Paragraph("<b>SRC-02 (Cover Audit)</b>", body_style), Paragraph("Automatically treats all institutional scholastic or demographic surveys inside border sectors as active collection operations rather than academic exercises.", body_style)],
        [Paragraph("<b>MANDATORY LOCKOUT</b>", body_style), Paragraph("Any unexpected data requests or coordination invitations from these specific state-linked clusters trigger an immediate, mandatory 24-hour verification delay.", body_style)]
    ]
    
    proto_table = Table(proto_data, colWidths=[150, 370])
    proto_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor("#1A252C")),
        ('TEXTCOLOR', (0,0), (-1,0), colors.white),
        ('PADDING', (0,0), (-1,-1), 6),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor("#D4D4D8")),
        ('VALIGN', (0,0), (-1,-1), 'TOP'),
    ]))
    # Quick text color adjustment for header row in table
    for i in range(2):
        proto_data[0][i].style.textColor = colors.white
        
    story.append(proto_table)
    story.append(Spacer(1, 20))
    
    # ----------------------------------------------------
    # FOOTER SIGN-OFF
    # ----------------------------------------------------
    story.append(HRFlowable(width="100%", thickness=0.5, color=colors.HexColor("#D4D4D8"), spaceAfter=10))
    story.append(Paragraph("<b>CRYPTOGRAPHIC REGISTRY SIGN-OFF:</b> SSISM V-ENGINE // REPLICATED AND LIVE.", subtitle_style))
    
    doc.build(story)

if __name__ == "__main__":
    create_vip_dossier()
